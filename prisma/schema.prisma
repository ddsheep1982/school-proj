generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EnrollmentStatus {
  ACTIVE
  WITHDRAWN
  GRADUATED
}

enum PaymentStatus {
  PAID
  PARTIAL
  OVERDUE
}

enum RecruitmentChannelType {
  TEACHER
  AGENT
}

enum PaymentType {
  CASH
  BANK_TRANSFER
  WECHAT
  ALIPAY
  OTHER
}

enum UserRole {
  ADMIN
  STAFF
}

enum FeeRecurrence {
  ONE_TIME
  TERM
  ANNUAL
}

enum RecruitmentCostRecipientType {
  TEACHER
  AGENT
  RECEPTION_TEACHER
}

model Campus {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  grades      Grade[]
}

model Grade {
  id        String   @id @default(cuid())
  name      String
  campusId  String
  campus    Campus   @relation(fields: [campusId], references: [id])
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  classes   Class[]

  @@unique([name, campusId])
}

model Class {
  id        String    @id @default(cuid())
  name      String
  capacity  Int
  gradeId   String?
  grade     Grade?    @relation(fields: [gradeId], references: [id])
  archived  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  students       Student[]
  feeAssignments FeeAssignment[]

  @@unique([name, gradeId])
}

model EnrollmentTeacher {
  id        String    @id @default(cuid())
  name      String
  phone     String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  enrolledStudents  Student[] @relation("EnrolledBy")
  recruitedStudents Student[] @relation("RecruitedByTeacher")
  receptionStudents Student[] @relation("ReceptionBy")
  recruitmentCosts  RecruitmentCost[]
}

model RecruitmentAgent {
  id           String    @id @default(cuid())
  name         String
  agencyName   String?
  phone        String
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  recruitedStudents Student[] @relation("RecruitedByAgent")
  recruitmentCosts  RecruitmentCost[]
}

model Student {
  id                     String                  @id @default(cuid())
  studentNo              String                  @unique
  name                   String
  phone                  String
  guardianPhone          String
  enrollmentDate         DateTime                @default(now())
  enrollmentStatus       EnrollmentStatus        @default(ACTIVE)
  paymentStatus          PaymentStatus           @default(PAID)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  classId                String?
  class                  Class?                  @relation(fields: [classId], references: [id])

  enrollmentTeacherId    String?
  enrollmentTeacher      EnrollmentTeacher?      @relation("EnrolledBy", fields: [enrollmentTeacherId], references: [id])

  recruitmentChannelType RecruitmentChannelType?
  recruitmentTeacherId   String?
  recruitmentTeacher     EnrollmentTeacher?      @relation("RecruitedByTeacher", fields: [recruitmentTeacherId], references: [id])
  recruitmentAgentId     String?
  recruitmentAgent       RecruitmentAgent?       @relation("RecruitedByAgent", fields: [recruitmentAgentId], references: [id])

  receptionTeacherId     String?
  receptionTeacher       EnrollmentTeacher?      @relation("ReceptionBy", fields: [receptionTeacherId], references: [id])

  withdrawalDate         DateTime?
  withdrawalReason       String?

  paymentRecords    PaymentRecord[]
  attendanceRecords AttendanceRecord[]
  feeAssignments    FeeAssignment[]
  invoices          Invoice[]
  recruitmentCosts  RecruitmentCost[]
  refundRecords     RefundRecord[]

  @@index([enrollmentStatus])
  @@index([paymentStatus])
  @@index([classId])
  @@index([enrollmentTeacherId])
}

model PaymentRecord {
  id           String      @id @default(cuid())
  studentId    String
  student      Student     @relation(fields: [studentId], references: [id])
  amount       Decimal     @db.Decimal(10, 2)
  paymentDate  DateTime
  paymentType  PaymentType
  notes        String?
  isAdjustment Boolean     @default(false)
  originalId   String?
  original     PaymentRecord?  @relation("Adjustments", fields: [originalId], references: [id])
  adjustments  PaymentRecord[] @relation("Adjustments")
  invoiceId    String?
  invoice      Invoice?        @relation(fields: [invoiceId], references: [id])
  createdById  String
  createdBy    User        @relation(fields: [createdById], references: [id])
  createdAt    DateTime    @default(now())

  @@index([invoiceId])
}

model AttendanceRecord {
  id        String    @id @default(cuid())
  studentId String
  student   Student   @relation(fields: [studentId], references: [id])
  date      DateTime  @db.Date
  checkIn   DateTime?
  checkOut  DateTime?
  duration  Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([studentId, date])
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  hashedPassword String
  role           UserRole        @default(STAFF)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  paymentRecords   PaymentRecord[]
  auditLogs        AuditLog[]
  recruitmentCosts RecruitmentCost[]
  refundRecords    RefundRecord[]
}

model FeeStructure {
  id           String        @id @default(cuid())
  name         String
  description  String?
  amount       Decimal       @db.Decimal(10, 2)
  recurrence   FeeRecurrence
  academicYear String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  assignments  FeeAssignment[]

  @@unique([name, academicYear])
}

model FeeAssignment {
  id              String       @id @default(cuid())
  feeStructureId  String
  feeStructure    FeeStructure @relation(fields: [feeStructureId], references: [id])
  studentId       String?
  student         Student?     @relation(fields: [studentId], references: [id])
  classId         String?
  class           Class?       @relation(fields: [classId], references: [id])
  dueDate         DateTime
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  invoices        Invoice[]

  @@index([feeStructureId])
  @@index([studentId])
  @@index([classId])
}

model Invoice {
  id              String        @id @default(cuid())
  feeAssignmentId String
  feeAssignment   FeeAssignment @relation(fields: [feeAssignmentId], references: [id], onDelete: Cascade)
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id])
  amountDue       Decimal       @db.Decimal(10, 2)
  dueDate         DateTime
  waivedAt        DateTime?
  waivedReason    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  payments        PaymentRecord[]
  refundRecords   RefundRecord[]

  @@unique([feeAssignmentId, studentId])
  @@index([studentId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String
  changes   Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model RecruitmentCost {
  id            String                       @id @default(cuid())
  studentId     String
  student       Student                      @relation(fields: [studentId], references: [id])
  amount        Decimal                      @db.Decimal(10, 2)
  paymentDate   DateTime
  recipientType RecruitmentCostRecipientType
  teacherId     String?
  teacher       EnrollmentTeacher?           @relation(fields: [teacherId], references: [id])
  agentId       String?
  agent         RecruitmentAgent?            @relation(fields: [agentId], references: [id])
  notes         String?
  createdById   String
  createdBy     User                         @relation(fields: [createdById], references: [id])
  createdAt     DateTime                     @default(now())

  @@index([studentId])
  @@index([teacherId])
  @@index([agentId])
  @@index([paymentDate])
}

model RefundRecord {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  invoiceId   String?
  invoice     Invoice? @relation(fields: [invoiceId], references: [id])
  amount      Decimal  @db.Decimal(10, 2)
  reason      String
  refundDate  DateTime
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([studentId])
}
